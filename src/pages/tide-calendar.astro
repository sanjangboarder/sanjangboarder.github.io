---
import Layout from '../layouts/Layout.astro';

// 서해 9대 거점 항구 물때 캘린더 데이터 정의
const BASE_REPO_URL = "https://raw.githubusercontent.com/sanjangboarder/tide_cal/main";

interface PortInfo {
  id: string;
  name: string;
  region: string;
  fishSummary: string;
  haerujilSummary: string;
  fishFile: string;
  haerujilFile: string;
  badge: string;
}

const ports: PortInfo[] = [
  {
    id: "incheon",
    name: "인천",
    region: "영흥도 · 대부도 · 시화 · 연안부두",
    fishSummary: "쭈꾸미, 갑오징어, 광어다운샷, 우럭",
    haerujilSummary: "영흥도/대부도/시화권 소라, 낙지, 조개",
    fishFile: "tides_incheon_2027.ics",
    haerujilFile: "tides_incheon_haerujil_2027.ics",
    badge: "수도권 인기 1위"
  },
  {
    id: "pyeongtaek",
    name: "평택",
    region: "아산만 · 당진 · 평택항",
    fishSummary: "쭈꾸미, 갑오징어, 우럭, 농어",
    haerujilSummary: "아산만/당진권 갯벌 박하지, 소라",
    fishFile: "tides_pyeongtaek_2027.ics",
    haerujilFile: "tides_pyeongtaek_haerujil_2027.ics",
    badge: "경기남부 거점"
  },
  {
    id: "sinjindo",
    name: "신진도 (안흥)",
    region: "태안 신진항 · 안흥외항 · 침선/어초",
    fishSummary: "광어다운샷, 침선우럭, 참돔타이라바, 백조기",
    haerujilSummary: "안면도/태안 서쪽 갯바위 해루질",
    fishFile: "tides_sinjindo_2027.ics",
    haerujilFile: "tides_sinjindo_haerujil_2027.ics",
    badge: "서해 외연도 출조"
  },
  {
    id: "mageompo",
    name: "마검포 (태안)",
    region: "천수만 북부 · 곰섬 · 안면도",
    fishSummary: "갑오징어, 쭈꾸미, 광어, 우럭",
    haerujilSummary: "마검포/곰섬 해수욕장 조개, 낙지, 박하지",
    fishFile: "tides_mageompo_2027.ics",
    haerujilFile: "tides_mageompo_haerujil_2027.ics",
    badge: "갑오징어 성지"
  },
  {
    id: "wonsando",
    name: "원산도 (보령)",
    region: "원산안면대교 · 저두항 · 선촌항",
    fishSummary: "갑오징어, 쭈꾸미, 백조기, 광어",
    haerujilSummary: "원산도 갯벌 바지락, 명주조개, 해삼",
    fishFile: "tides_wonsando_2027.ics",
    haerujilFile: "tides_wonsando_haerujil_2027.ics",
    badge: "천수만 관문"
  },
  {
    id: "muchangpo",
    name: "무창포 (보령)",
    region: "무창포항 · 대천 · 남보령",
    fishSummary: "쭈꾸미, 갑오징어, 참돔타이라바, 백조기",
    haerujilSummary: "신비의 바닷길 석대도 해루질, 소라/해삼",
    fishFile: "tides_muchangpo_2027.ics",
    haerujilFile: "tides_muchangpo_haerujil_2027.ics",
    badge: "가을 쭈갑 메카"
  },
  {
    id: "hongwon",
    name: "홍원항 (서천)",
    region: "마량진항 · 춘장대 · 어란",
    fishSummary: "참돔타이라바, 쭈꾸미, 갑오징어, 농어",
    haerujilSummary: "춘장대 해수욕장 맛조개, 골뱅이 해루질",
    fishFile: "tides_hongwon_2027.ics",
    haerujilFile: "tides_hongwon_haerujil_2027.ics",
    badge: "서해 중남부 허브"
  },
  {
    id: "gunsan",
    name: "군산",
    region: "비응항 · 야미도 · 신시도 · 고군산군도",
    fishSummary: "참돔타이라바, 광어다운샷, 쭈갑, 문어",
    haerujilSummary: "새만금 방조제 내측/외측 해루질",
    fishFile: "tides_gunsan_2027.ics",
    haerujilFile: "tides_gunsan_haerujil_2027.ics",
    badge: "원도권 대물 포인트"
  },
  {
    id: "mokpo",
    name: "목포",
    region: "목포 북항 · 남항 · 압해도",
    fishSummary: "갈치(풀치), 감성돔, 농어, 문어",
    haerujilSummary: "신안/무안 갯벌 낙지, 게, 조개",
    fishFile: "tides_mokpo_2027.ics",
    haerujilFile: "tides_mokpo_haerujil_2027.ics",
    badge: "서남해안 중심"
  }
];

const generalCalendarUrl = `${BASE_REPO_URL}/tides_west_2027.ics?v=7`;

// Helper: 구글 캘린더 웹 등록 URL 생성
function getGoogleCalUrl(icsUrl: string) {
  return `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(icsUrl)}`;
}

// Helper: 웹칼(애플 캘린더) 프로토콜 URL 생성
function getWebcalUrl(icsUrl: string) {
  return icsUrl.replace(/^https?:\/\//i, 'webcal://');
}
---

<Layout 
  title="2027 서해 물때표 구글 캘린더 (낚시 & 해루질) - 산장보더"
  description="2027년 서해안 9대 거점(인천, 평택, 신진도, 마검포, 원산도, 무창포, 홍원항, 군산, 목포) 낚시 및 해루질 맞춤 물때를 구글 캘린더, 애플 캘린더에 원클릭으로 구독하세요."
>
  <main class="tide-page container">
    <!-- Hero Section -->
    <header class="tide-hero glass">
      <div class="tide-hero-badges">
        <span class="pill-badge pill-accent">2027 EXCLUSIVE</span>
        <span class="pill-badge">GOOGLE CALENDAR SYNC</span>
      </div>
      <h1 class="tide-title gradient-text">
        2027 서해 물때표 구글 캘린더
      </h1>
      <p class="tide-subtitle">
        매번 출조 때마다 물때표 앱 찾지 마세요!<br />
        서해안 9대 거점 항구별 <strong>[어종 맞춤 출조 신호등]</strong>과 <strong>[해루질 황금 간조물때]</strong>를<br class="pc-only" />
        내 스마트폰 캘린더에 원클릭으로 등록하고 매일 아침 자동으로 확인하세요.
      </p>

      <div class="hero-stats">
        <div class="h-stat-item">
          <span class="h-stat-num">9개</span>
          <span class="h-stat-label">서해안 주요 거점</span>
        </div>
        <div class="h-stat-divider"></div>
        <div class="h-stat-item">
          <span class="h-stat-num">18종</span>
          <span class="h-stat-label">낚시/해루질 전용 달력</span>
        </div>
        <div class="h-stat-divider"></div>
        <div class="h-stat-item">
          <span class="h-stat-num">365일</span>
          <span class="h-stat-label">조류 세기 & 고저차 분석</span>
        </div>
        <div class="h-stat-divider"></div>
        <div class="h-stat-item">
          <span class="h-stat-num">100%</span>
          <span class="h-stat-label">무료 구독 & 자동 갱신</span>
        </div>
      </div>
    </header>

    <!-- Interactive Navigation Tabs -->
    <section class="tide-tabs-wrapper">
      <div class="tide-tabs" role="tablist">
        <button class="tide-tab active" data-tab="fishing" role="tab" aria-selected="true">
          <span class="tab-icon">🎣</span>
          <span class="tab-text">낚시물때 캘린더 (9개소)</span>
          <span class="tab-pill">어종별 신호등</span>
        </button>
        <button class="tide-tab" data-tab="haerujil" role="tab" aria-selected="false">
          <span class="tab-icon">🤿</span>
          <span class="tab-text">해루질물때 캘린더 (9개소)</span>
          <span class="tab-pill">최저간조 & 안전퇴수</span>
        </button>
        <button class="tide-tab" data-tab="general" role="tab" aria-selected="false">
          <span class="tab-icon">🌊</span>
          <span class="tab-text">서해 전역 기본물때</span>
          <span class="tab-pill">물때명/음력</span>
        </button>
      </div>
    </section>

    <!-- Tab 1: Fishing Calendars -->
    <section id="panel-fishing" class="tab-panel active">
      <div class="panel-header">
        <div class="panel-info">
          <h2>🎣 2027 거점별 [낚시물때] 캘린더</h2>
          <p>월별 대표 대상어(우럭, 광어, 참돔, 농어, 백조기, 쭈꾸미)에 적합한 조류 유속(고저차 비율)을 계산하여 출조 신호등을 제공합니다.</p>
        </div>
        <div class="legend-box glass">
          <span class="legend-item"><span class="sig-dot dot-green"></span> 🟢 최고 (황금조류)</span>
          <span class="legend-item"><span class="sig-dot dot-yellow"></span> 🟡 양호 (추천)</span>
          <span class="legend-item"><span class="sig-dot dot-white"></span> ⚪ 보통 (무난)</span>
          <span class="legend-item"><span class="sig-dot dot-red"></span> 🔴 비추 (급류)</span>
        </div>
      </div>

      <div class="ports-grid">
        {ports.map((port) => {
          const icsUrl = `${BASE_REPO_URL}/calendars/${port.fishFile}?v=7`;
          const gCalUrl = getGoogleCalUrl(icsUrl);
          const webcalUrl = getWebcalUrl(icsUrl);
          return (
            <article class="port-card glass">
              <div class="port-card-header">
                <div class="port-title-group">
                  <span class="port-badge">{port.badge}</span>
                  <h3 class="port-name">{port.name} 낚시물때</h3>
                </div>
                <span class="port-pin">📍</span>
              </div>

              <div class="port-desc">
                <p class="port-region"><strong>주요 출조권:</strong> {port.region}</p>
                <p class="port-target"><strong>추천 어종:</strong> {port.fishSummary}</p>
              </div>

              <div class="port-card-actions">
                <a href={gCalUrl} target="_blank" rel="noopener noreferrer" class="btn-gcal">
                  <span class="btn-icon">📅</span>
                  <span>구글 캘린더 바로 추가</span>
                </a>
                <div class="sub-actions">
                  <button class="btn-copy" data-copy-url={icsUrl}>
                    <span class="btn-icon">📋</span> URL 복사
                  </button>
                  <a href={webcalUrl} class="btn-apple" title="아이폰/애플 캘린더 구독">
                    <span class="btn-icon">🍎</span> 애플 연동
                  </a>
                  <a href={icsUrl} download={port.fishFile} class="btn-download" title="ICS 파일 다운로드">
                    <span class="btn-icon">💾</span> .ics
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Tab 2: Haerujil Calendars -->
    <section id="panel-haerujil" class="tab-panel">
      <div class="panel-header">
        <div class="panel-info">
          <h2>🤿 2027 거점별 [해루질물때] 캘린더</h2>
          <p>물이 가장 많이 빠지는 사리(대조기) 전후 간조 최저 수위와 마이너스 조위를 분석하여 해루질 최적 물때와 안전 퇴수시간을 알려드립니다.</p>
        </div>
        <div class="legend-box glass">
          <span class="legend-item"><span class="sig-dot dot-green"></span> 🟢 최상 (대박 물때 95%↑)</span>
          <span class="legend-item"><span class="sig-dot dot-yellow"></span> 🟡 좋음 (적극 추천 88~94%)</span>
          <span class="legend-item"><span class="sig-dot dot-white"></span> ⚪ 괜찮음 (무난 80~87%)</span>
          <span class="legend-item"><span class="sig-dot dot-red"></span> 🔴 별로 (80% 미만)</span>
        </div>
      </div>

      <div class="ports-grid">
        {ports.map((port) => {
          const icsUrl = `${BASE_REPO_URL}/calendars/${port.haerujilFile}?v=7`;
          const gCalUrl = getGoogleCalUrl(icsUrl);
          const webcalUrl = getWebcalUrl(icsUrl);
          return (
            <article class="port-card glass haerujil-card">
              <div class="port-card-header">
                <div class="port-title-group">
                  <span class="port-badge haerujil-badge">{port.badge}</span>
                  <h3 class="port-name">{port.name} 해루질물때</h3>
                </div>
                <span class="port-pin">🤿</span>
              </div>

              <div class="port-desc">
                <p class="port-region"><strong>해루질 포인트:</strong> {port.region}</p>
                <p class="port-target"><strong>주요 채집물:</strong> {port.haerujilSummary}</p>
              </div>

              <div class="port-card-actions">
                <a href={gCalUrl} target="_blank" rel="noopener noreferrer" class="btn-gcal btn-gcal-blue">
                  <span class="btn-icon">📅</span>
                  <span>구글 캘린더 바로 추가</span>
                </a>
                <div class="sub-actions">
                  <button class="btn-copy" data-copy-url={icsUrl}>
                    <span class="btn-icon">📋</span> URL 복사
                  </button>
                  <a href={webcalUrl} class="btn-apple" title="아이폰/애플 캘린더 구독">
                    <span class="btn-icon">🍎</span> 애플 연동
                  </a>
                  <a href={icsUrl} download={port.haerujilFile} class="btn-download" title="ICS 파일 다운로드">
                    <span class="btn-icon">💾</span> .ics
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Tab 3: General West Sea Calendar -->
    <section id="panel-general" class="tab-panel">
      <div class="panel-header">
        <div class="panel-info">
          <h2>🌊 서해 전역 기본 물때 (물때명 & 음력)</h2>
          <p>어종 분석이나 해루질 지수 없이, 서해안 표준 7~8물 사리/조금 물때명과 음력 날짜만 심플하게 보고 싶으신 분들을 위한 기본 캘린더입니다.</p>
        </div>
      </div>

      <div class="general-card-wrapper">
        <article class="port-card glass general-featured-card">
          <div class="port-card-header">
            <div class="port-title-group">
              <span class="port-badge">서해 전역 통합</span>
              <h3 class="port-name">2027 서해 표준 기본 물때 캘린더</h3>
            </div>
            <span class="port-pin">🌊</span>
          </div>

          <p class="general-desc">
            일정 제목에 <code>13물/음 12월7일</code>, <code>조금/음 12월8일</code> 형태로 간결하게 표시되어 다른 캘린더 일정과 겹쳐도 깔끔하게 일정을 확인할 수 있습니다.
          </p>

          <div class="port-card-actions">
            <a href={getGoogleCalUrl(generalCalendarUrl)} target="_blank" rel="noopener noreferrer" class="btn-gcal btn-gcal-cyan">
              <span class="btn-icon">📅</span>
              <span>구글 캘린더에 바로 추가하기</span>
            </a>
            <div class="sub-actions">
              <button class="btn-copy" data-copy-url={generalCalendarUrl}>
                <span class="btn-icon">📋</span> 구독 URL 복사
              </button>
              <a href={getWebcalUrl(generalCalendarUrl)} class="btn-apple">
                <span class="btn-icon">🍎</span> 애플 연동
              </a>
              <a href={generalCalendarUrl} download="tides_west_2027.ics" class="btn-download">
                <span class="btn-icon">💾</span> .ics 다운로드
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Information & Guide Section -->
    <section class="tide-info-section">
      <div class="info-card glass">
        <div class="info-header">
          <span class="info-icon">📱</span>
          <h3>스마트폰 캘린더에서 어떻게 표시되나요?</h3>
        </div>
        <p class="info-intro">
          캘린더를 구독하면 매일 일정 제목에 직관적인 신호등과 핵심 정보가 표시되며, 날짜를 누르면 상세 출조 정보가 펼쳐집니다.
        </p>

        <div class="preview-mockups">
          <div class="mockup-box">
            <div class="mockup-title">🎣 낚시물때 상세 예시</div>
            <pre class="mockup-code">
📍 관측지점: 서해 인천 (낚시물때)
📅 양력: 2027년 09월 10일 (금) • 🌙 음력: 8.10
🌊 물때: 1물 (일일 평균 고저차 184cm / 20%)

🎯 [9월 주요 어종별 출조 적합도]:
  • 쭈꾸미 (주력) : ★★★★★ 🟢 (최적의 조류! 봉돌 10~12호 가볍게 운용)
  • 갑오징어 : ★★★★★ 🟢 (최적의 조류! 봉돌 10~12호 가볍게 운용)
  • 광어 : ★★☆☆☆ 🔴 (조류 너무 느림)
  • 우럭 : ★★★☆☆ ⚪ (조류 다소 정체)

🔻 [간조]: 06:36(416cm), 18:30(330cm)
🌊 [만조]: 12:05(644cm)
☀️ 일출/일몰: 06:12 / 18:50</pre>
          </div>

          <div class="mockup-box">
            <div class="mockup-title">🤿 해루질물때 상세 예시</div>
            <pre class="mockup-code">
📍 관측지점: 서해 인천 (해루질물때)
📅 양력: 2027년 09월 03일 (금) • 🌙 음력: 8.03
🌊 물때: 9물 (사리 / 고저차 960cm / 107%)

🤿 [해루질 적합도]: ★★★★★ 🟢
👉 평가: 최상 (대박 물때! 물 극도로 빠짐, 깊은 갯벌 노출)
🔻 최저 간조: 00:21 (-23cm)

⏰ [해루질 안전 시간 가이드]:
  • 🚪 진입 추천: 간조 2시간 전부터 진입
  • 🚨 철수 필수: 간조 시각 1시간 후 반드시 퇴수!

⚠️ 해루질 안전수칙: 2인 1조 동행, 구명조끼 필수, 알람 필수</pre>
          </div>
        </div>
      </div>

      <!-- 30s Setup Guide -->
      <div class="info-card glass">
        <div class="info-header">
          <span class="info-icon">⚡</span>
